# Decodo Web Data API key: https://dashboard.decodo.com/web-data/playground
DECODO_API_KEY=

# Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Path to the Google service account JSON key, and the id of the sheet shared with it.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# Optional: a Gemini model id. Defaults to the Google ADK default model.
# GEMINI_MODEL=
